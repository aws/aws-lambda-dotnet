<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\buildtools\common.props" />  

  <PropertyGroup>
    <TargetFrameworks>$(DefaultPackageTargets)</TargetFrameworks>
    <AssemblyName>AWS.OCI.Builder</AssemblyName>
    <PackageId>AWS.OCI.Builder</PackageId>
    <RootNamespace>AWS.OCI.Builder</RootNamespace>
    <Description>A .NET library for building OCI container images programmatically — overlay local files as a new layer on a base image and push the result to Amazon ECR, without a Docker daemon.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Native AOT / trimming: mark the assembly trim-safe and turn on the analyzers so trim/AOT
         warnings surface at build time. The library has no reflection-based serialization left;
         all System.Text.Json goes through the source-generated OciJsonContext. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
    
    <!-- NuGet package metadata -->
    <Version>0.5.0</Version>
    <Product>AWS.OCI.Builder</Product>
    <PackageTags>aws;ecr;oci;container;docker;image;registry</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/aws/aws-lambda-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/aws/aws-lambda-dotnet</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ship the README inside the package so it renders on the NuGet gallery. -->
    <None Include=".\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Internal types (RealmValidator, etc.) are exercised directly by the test project. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AWS.OCI.Builder.Tests, PublicKey=""</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
